# VITIS configuration. Copy to .env locally; set as service variables on Railway.
# Never commit a real .env.

# --- Claude (all structuring, ideation, concepts, web search) ---------------
ANTHROPIC_API_KEY=
# Creative tier: writes the ideas and concepts participants rate.
ANTHROPIC_MODEL=claude-opus-5
# Fast tier: structuring and retrieval (CAE, problems, AOPC, keywords, phenomena search, render prompts).
ANTHROPIC_MODEL_FAST=claude-sonnet-5
# Which purposes go to the creative tier. Everything else uses the fast tier.
# Purposes: cae_extract, problems_identify, aopc, traditional_structure, keywords,
#           phenomena, ideas_modern, ideas_inspider, concept, render_prompts
ANTHROPIC_CREATIVE_PURPOSES=ideas_modern,ideas_inspider,concept
# Claude's native web-search tool, used in the phenomena stage.
CLAUDE_WEB_SEARCH=true
# Searches per phenomena call. Each search's results are re-read on every later
# turn of that call, so this is the biggest cost lever. Measured: 3 searches ~31k input
# tokens per call, 2 searches ~20k. 8 was ~5x the cost of 3.
CLAUDE_WEB_SEARCH_MAX_USES=2

# --- OpenAI (images + embeddings for new phenomenon nodes) -------------------
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high (1024x1024: $0.011 / $0.042 / $0.167 per image).
# The product shot is what participants judge; the in-use scene is context.
OPENAI_IMAGE_QUALITY_PRODUCT=medium
OPENAI_IMAGE_QUALITY_IN_USE=low
# Default for the console's "In-use scene renders" switch: false = product shot only.
RENDER_IN_USE=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# --- Providers: real | mock ---------------------------------------------------
# mock runs the whole study with canned AI output and placeholder images.
# Use it to rehearse the flow and to run the tests. Never for a real participant.
AI_PROVIDER=real

# --- Database -----------------------------------------------------------------
# SQLite locally. On Railway mount a volume at /data and set:
#   DATABASE_URL=sqlite:////data/vitis.sqlite
# For Postgres later: DATABASE_URL=postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./data/vitis.sqlite
# Generated images are stored here (put it on the same volume in production).
IMAGE_DIR=backend/data/images

# --- Inspider web -------------------------------------------------------------
# Built web files (nodes/edges/clusters parquet, embeddings.npz, provenance.json).
# Copied from inspider-web-KG-app/data into backend/inspider_data/. Imported into
# VITIS's own database on first boot. Refuses a dev build.
# On Railway with Root Directory backend: INSPIDER_DATA_DIR=/app/inspider_data
# (or keep them on the volume at /data/inspider).
INSPIDER_DATA_DIR=backend/inspider_data

# --- Study defaults (per-participant overrides in the console) ----------------
IDEAS_PER_CONDITION=5
CONCEPTS_PER_IDEA=1
KEYWORDS_PROPOSED=5
NEIGHBOURS_SHOWN=5
# Neighbour verbs a participant may add per keyword.
NEIGHBOURS_MAX_PICK=3
PHENOMENA_PER_KEYWORD=3
# After neighbour picking the pool (proposed + picked) is cut to the most mutually
# distant verbs; phenomena are searched for those only and each inspires one idea.
# 0 = as many as IDEAS_PER_CONDITION. KEYWORD_SWAPS_MAX: swaps the participant may make.
KEYWORDS_FINAL=0
KEYWORD_SWAPS_MAX=1

# --- Cost meter (USD list prices; override when they change) ------------------
# Claude per million input/output tokens; web search per 1,000 searches; images per 1024x1024.
PRICE_OPUS_INPUT_PER_M=5
PRICE_OPUS_OUTPUT_PER_M=25
PRICE_SONNET_INPUT_PER_M=2
PRICE_SONNET_OUTPUT_PER_M=10
PRICE_WEB_SEARCH_PER_1000=10
PRICE_IMAGE_LOW=0.011
PRICE_IMAGE_MEDIUM=0.042
PRICE_IMAGE_HIGH=0.167

# --- Security -----------------------------------------------------------------
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_SALT=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5175
PARTICIPANT_TOKEN_TTL_HOURS=72
EXPERIMENTER_TOKEN_TTL_HOURS=12

# --- Experimenter accounts (used only by `python -m app.seed`) -----------------
EXPERIMENTER_VITI_PASSWORD=
EXPERIMENTER_SANKAR_PASSWORD=

# --- Servers --------------------------------------------------------------------
BACKEND_PORT=8010
FRONTEND_PORT=5175
