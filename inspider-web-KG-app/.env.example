# Inspider Web Visualizer configuration.
# Copy to .env. The .env file is git-ignored - never commit a real key.

# --- OpenAI (embeddings; optional GPT glossing and cluster naming) ---------
OPENAI_API_KEY=
# Highest-quality embedding model. 3072 dimensions. ~$0.13 per 1M tokens.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Full dimensionality. Lower (1024, 256) shrinks storage; quality drops slightly.
EMBEDDING_DIMENSIONS=3072
# Chat model used ONLY if you turn on GPT glossing / cluster naming.
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Embedding provider -----------------------------------------------------
# openai : real embeddings (needs the key above)
# local  : sentence-transformers on this machine, no API, lower quality
# dev    : deterministic pseudo-embeddings for smoke tests ONLY - not meaningful
EMBEDDING_PROVIDER=openai
# For provider=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Graph construction -----------------------------------------------------
# Neighbours kept per verb. The app can show fewer live; more needs a rebuild.
KNN_K=50
# Leiden resolution: higher = more, smaller clusters.
CLUSTER_RESOLUTION=1.0

# --- Embedding run ----------------------------------------------------------
EMBED_BATCH_SIZE=1024
EMBED_CONCURRENCY=8
# Set true to have GPT write a one-line gloss for verbs WordNet does not know.
GPT_GLOSS_MISSING=false
# Set true to have GPT name the clusters (else named by their central verbs).
GPT_NAME_CLUSTERS=false

# --- Servers ----------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5174
# Where data files live (relative to repo root, or an absolute path such as /data on Railway)
DATA_DIR=data
# Comma-separated browser origins allowed to call the API (Vercel production URL, etc.)
CORS_ORIGINS=
# Optional regex so every Vercel preview URL is allowed, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=
