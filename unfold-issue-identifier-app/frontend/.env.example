# Frontend configuration.
#
# WARNING: everything with a VITE_ prefix is compiled into the public bundle and
# is readable by anyone who opens the site. Never put the Anthropic key, or any
# other secret, in this file. The LLM key belongs in the backend environment only.

# Base URL of the Railway backend. Leave blank in local development to use the
# Vite dev proxy defined in vite.config.js.
VITE_API_BASE_URL=

# Only used by `npm run dev` to point the proxy at a backend on another port.
VITE_DEV_API_TARGET=http://localhost:4000
