# UNFOLD backend configuration.
# Copy to .env for local development. On Railway, set these as service variables.
# NEVER commit a real .env -- .gitignore already excludes it.

NODE_ENV=development
PORT=4000

# --- Database -------------------------------------------------------------
# Local: leave unset and it writes to ../database/unfold.sqlite
# Railway: mount a volume at /data and set this to /data/unfold.sqlite
# DATABASE_PATH=/data/unfold.sqlite

# --- Security -------------------------------------------------------------
# Salts IP addresses before hashing. Generate one and never change it afterwards:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes old and new hashes incomparable.
IP_HASH_SALT=replace-with-a-long-random-string

# Comma-separated. Add your Vercel production and preview URLs here.
CORS_ORIGINS=http://localhost:5173

# Where the participant's browser is served from. Used to build the guardian
# consent link inside the QR code, so this MUST be the frontend URL, not the API.
PUBLIC_APP_URL=http://localhost:5173

SESSION_TOKEN_TTL_HOURS=72
GUARDIAN_REQUEST_TTL_MINUTES=120
ADMIN_SESSION_TTL_HOURS=12

# --- Claude (Phase 3) -----------------------------------------------------
# Server-side only. This key must never appear in the frontend build.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Set to false to run the whole instrument on the rule-based fallback, which is
# how you demo or pilot without spending credits.
LLM_ENABLED=true

# --- Study parameters -----------------------------------------------------
STUDY_MIN_AGE=15
STUDY_MAX_AGE=50
STUDY_MINOR_THRESHOLD=18
PARTICIPANT_CODE_PREFIX=P

# --- Researcher accounts --------------------------------------------------
# Applied automatically when the API starts (local or Railway). Leave set.
ADMIN_VITI_PASSWORD=
ADMIN_VITI_EMAIL=
ADMIN_SANKAR_PASSWORD=
ADMIN_SANKAR_EMAIL=
